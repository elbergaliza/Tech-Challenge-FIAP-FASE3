# Copie para `.env` na raiz do repositório (já referenciado em `.vscode/launch.json`).
# O carregador também lê `.env` no diretório de trabalho atual, se existir.

# --- Prioridade 1: modelo causal completo (ex.: merge LoRA → pasta com pesos completos) ---
# LOCAL_MODEL_PATH=C:/caminho/para/modelo-mesclado

# --- Prioridade 2a: checkpoint intermediário do Trainer (mesmo formato PEFT) ---
# LORA_CHECKPOINT_DIR=data/checkpoints/qwen2.5-3b-medpt-lora/checkpoint-3750

# --- Prioridade 2b: adapter final (saída do tunning/02) + modelo base ---
# Caminho absoluto ou relativo ao CWD / raiz do repo; vazio desativa explícito.
# LORA_ADAPTER_PATH=../pre-trained/qwen2.5-3b-medpt-lora
# Base no Hub (padrão: CAMINHO_DO_MODELO ou base_model_name em training_metadata.json).
# LORA_BASE_MODEL=Qwen/Qwen2.5-3B-Instruct
# Sobrescreve system message (senão: training_metadata.json ou configuracoes.py).
# LLM_SYSTEM_MESSAGE=
# LORA_AUTO_DISCOVER=1

# --- Prioridade 3: Ollama (API OpenAI-compatível) ---
# OLLAMA_BASE_URL=https://api.ollama.com
# OLLAMA_API_KEY=
# OLLAMA_MODEL=gemma3:4b

# --- Prioridade 4: pipeline HuggingFace (Hub ou pasta local) ---
# Sobrescreve o fallback definido em langchain/configuracoes.py (CAMINHO_DO_MODELO).
# HF_PIPELINE_MODEL=gpt2

# --- Geração local ---
# LOCAL_MAX_NEW_TOKENS=512
# LOCAL_TEMPERATURE=0.3
# LOCAL_REPETITION_PENALTY=1.1
# LOCAL_TOP_P=0.9
# LOCAL_TOP_K=50
# LOCAL_CHAT_TEMPLATE=1
